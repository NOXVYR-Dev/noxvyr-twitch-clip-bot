# Discord Developer Portal: Bot-Token des Discord-Bots (nur auf dem Host speichern)
DISCORD_BOT_TOKEN=

# Twitch Developer Console: Client ID und Client Secret einer Twitch-Anwendung
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Abfrageintervall in Sekunden (mindestens 30; Standard 60)
POLL_SECONDS=60

# Optional: Zeitfenster-Überlappung gegen Twitch-Verzögerungen (Standard 900)
OVERLAP_SECONDS=900
